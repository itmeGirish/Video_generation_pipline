# ===========================================
# Video Explainer - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to git (it's in .gitignore)
# ===========================================

# --- API Keys ---

# ElevenLabs TTS (required for real voiceover)
# Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_f80a11d2cfda7831d1bf04a24bbaa2b07f1751bb7ff48955

# Anthropic API (only if using provider: "anthropic" in config.yaml)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API (only if using provider: "openai" in config.yaml)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Model Configuration ---

# Override the default LLM model (default: claude-sonnet-4-20250514)
# LLM_DEFAULT_MODEL=claude-sonnet-4-20250514

# Override the fact-checking model (default: claude-opus-4-5-20251101)
# FACTCHECK_MODEL=claude-opus-4-5-20251101

# --- ElevenLabs Configuration ---

# Override the ElevenLabs API base URL
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Override the default voice ID (default: Rachel - 21m00Tcm4TlvDq8ikWAM)
# ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Remotion Configuration ---

# Override the Remotion dev server URL
# REMOTION_DEV_URL=http://localhost:3000

# Override video dimensions for Remotion compositions
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=30
# SHORTS_WIDTH=1080
# SHORTS_HEIGHT=1920

# --- Test Configuration ---

# Path to a test document for integration tests
# TEST_INFERENCE_DOC=tests/fixtures/sample.md
